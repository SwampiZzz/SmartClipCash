pragma cashscript ^0.13.0;

contract CouponRedeem(
    pubkey businessPk,
    bool transferable,
    bytes32 couponCategory,
    int discountValue
) {
    function redeem(sig businessSig, pubkey redeemerPk, sig redeemerSig) {
        require(checkSig(businessSig, businessPk));

        require(tx.inputs[0].tokenCategory == couponCategory);

        bytes commitment = tx.inputs[0].nftCommitment;
        bytes4 expiryBytes, bytes ownerPKH = commitment.split(4);
        int expiry = int(expiryBytes);

        require(tx.locktime < expiry); // expiry enforcement, straight from the token itself

        if (!transferable) {
            require(hash160(redeemerPk) == ownerPKH);
        }
        require(checkSig(redeemerSig, redeemerPk));

        int minerFee = 1000;
        int inputValue = tx.inputs[this.activeInputIndex].value;
        int merchantChange = inputValue - discountValue - minerFee;
        require(merchantChange >= 0);

        bytes25 merchantLock = new LockingBytecodeP2PKH(hash160(businessPk));

        // Output 0 pays the discount to the redeemer.
        // Output 1 returns BCH change to merchant.
        // There is no token output, so the coupon NFT is consumed forever.
        require(tx.outputs.length == 2);
        require(tx.outputs[0].value == discountValue);
        require(tx.outputs[1].value == merchantChange);
        require(tx.outputs[1].lockingBytecode == merchantLock);
    }
}
